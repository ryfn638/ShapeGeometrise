{
    // Terminal > Run Build Task (Ctrl+Shift+B) builds Release. "Run" builds then starts the program.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": ["Release"],
            "options": { "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] } },
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "${workspaceFolder}\\build.bat",
            "args": ["Debug"],
            "options": { "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] } },
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "start \"\" \"${workspaceFolder}\\build\\bin\\Release\\ImageGeometrise\\ImageGeometrise.exe\"",
            "options": { "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] } },
            "dependsOn": "Build (Release)",
            "problemMatcher": []
        }
    ]
}
